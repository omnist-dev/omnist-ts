{
  "name": "@omnist-dev/omnist",
  "version": "0.0.1-alpha",
  "description": "One data model, many formats: read, validate, and write JSON, YAML, TOML, XML, and OML. (TypeScript port of https://github.com/omnist-dev/omnist)",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Thomas Y. Lee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnist-dev/omnist-ts.git"
  },
  "keywords": [
    "schema",
    "validation",
    "json",
    "yaml",
    "toml",
    "xml",
    "data",
    "convert"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "omnist": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependenciesMeta": {
    "yaml": {
      "optional": true
    },
    "smol-toml": {
      "optional": true
    },
    "fast-xml-parser": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "fast-xml-parser": "^4.5.0",
    "smol-toml": "^1.3.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "fast-check": "^3.20.0",
    "fast-xml-parser": "^4.5.7",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
